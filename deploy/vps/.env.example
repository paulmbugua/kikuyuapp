POSTGRES_DB=kikuyuapp
POSTGRES_USER=kikuyuapp
POSTGRES_PASSWORD=replace-with-a-long-random-value
REDIS_PASSWORD=replace-with-a-long-random-value

NODE_ENV=production
PORT=5000
API_PREFIX=/api/v1
DATABASE_URL=postgresql://kikuyuapp:replace-with-a-long-random-value@postgres:5432/kikuyuapp
REDIS_URL=redis://:replace-with-a-long-random-value@redis:6379
JWT_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value
WEB_BACKEND_URL=https://server.example.invalid
FRONTEND_URL=https://example.invalid,https://www.example.invalid
CORS_ORIGIN=https://example.invalid,https://www.example.invalid
GOOGLE_CLIENT_ID=replace-with-existing-value
GOOGLE_CLIENT_SECRET=replace-with-existing-value
GOOGLE_CALLBACK_URL=https://server.example.invalid/api/v1/auth/google/callback
R2_ENDPOINT=replace-with-existing-value
R2_REGION=auto
R2_ACCESS_KEY_ID=replace-with-existing-value
R2_SECRET_ACCESS_KEY=replace-with-existing-value
R2_BUCKET_IMAGES=replace-with-existing-value
R2_PUBLIC_BASE_URL_IMAGES=replace-with-existing-value
R2_BUCKET_COVER=replace-with-existing-value
R2_PUBLIC_BASE_URL_COVER=replace-with-existing-value
CLOUDINARY_CLOUD_NAME=replace-with-existing-value
CLOUDINARY_API_KEY=replace-with-existing-value
CLOUDINARY_API_SECRET=replace-with-existing-value
SMTP_HOST=replace-with-existing-value
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=replace-with-existing-value
SMTP_PASS=replace-with-existing-value
MAIL_FROM=replace-with-existing-value
MAIL_REPLY_TO=replace-with-existing-value

BACKUP_PASSPHRASE=replace-with-a-separately-stored-backup-key
CLOUDFLARE_TUNNEL_TOKEN=replace-with-a-dedicated-tunnel-token
NEXT_PUBLIC_API_URL=https://server.example.invalid/api/v1
NEXT_PUBLIC_SITE_URL=https://www.example.invalid

